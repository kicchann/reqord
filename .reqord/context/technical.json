{
  "techStack": {
    "language": {
      "name": "TypeScript",
      "version": "5.x",
      "description": "型安全なフルスタック開発"
    },
    "runtime": {
      "name": "Node.js",
      "version": "20+",
      "description": "モダンなJavaScript実行環境"
    },
    "cli": [
      {
        "name": "Commander.js",
        "purpose": "CLIフレームワーク"
      },
      {
        "name": "Inquirer.js",
        "purpose": "対話型プロンプト"
      },
      {
        "name": "Octokit.js",
        "purpose": "GitHub API連携"
      }
    ],
    "web": [
      {
        "name": "Next.js",
        "version": "15",
        "purpose": "App Router SSR/SSG"
      },
      {
        "name": "Tailwind CSS",
        "purpose": "ユーティリティファーストCSS"
      },
      {
        "name": "React Markdown",
        "purpose": "Markdownレンダリング"
      },
      {
        "name": "Mermaid.js",
        "purpose": "図表描画（依存関係グラフ、アーキテクチャ図）"
      },
      {
        "name": "Recharts",
        "purpose": "Ganttチャート、進捗グラフ"
      }
    ],
    "ai": [
      {
        "name": "Anthropic SDK",
        "purpose": "Claude API連携（要件詳細化、設計生成、タスク分解）"
      }
    ],
    "shared": [
      {
        "name": "Zod",
        "purpose": "スキーマバリデーション（JSON構造の検証）"
      }
    ]
  },
  "developmentEnvironment": {
    "requiredTools": [
      "Node.js 20+",
      "Git",
      "npm (workspaces対応)"
    ],
    "setupCommands": [
      "npm install",
      "npm run build"
    ]
  },
  "commonCommands": {
    "development": [
      {
        "command": "npm run dev",
        "description": "開発サーバー起動（Web UI）"
      },
      {
        "command": "npm run dev:cli",
        "description": "CLI開発モード（ts-node）"
      }
    ],
    "build": [
      {
        "command": "npm run build",
        "description": "全パッケージビルド"
      },
      {
        "command": "npm run build:cli",
        "description": "CLIパッケージのみビルド"
      },
      {
        "command": "npm run build:web",
        "description": "Webパッケージのみビルド"
      }
    ],
    "test": [
      {
        "command": "npm test",
        "description": "全テスト実行"
      },
      {
        "command": "npm run test:watch",
        "description": "ウォッチモードでテスト"
      },
      {
        "command": "npm run test:coverage",
        "description": "カバレッジ付きテスト"
      }
    ],
    "lint": [
      {
        "command": "npm run lint",
        "description": "ESLint実行"
      },
      {
        "command": "npm run format",
        "description": "Prettier実行"
      }
    ],
    "reqord": [
      {
        "command": "reqord init",
        "description": ".reqord/ + GitHub Issue Templates作成"
      },
      {
        "command": "reqord context init",
        "description": "ProjectContext作成"
      },
      {
        "command": "reqord req create <title>",
        "description": "要件作成"
      },
      {
        "command": "reqord req enhance <id>",
        "description": "AI要件詳細化"
      },
      {
        "command": "reqord spec create <req-id>",
        "description": "仕様作成"
      },
      {
        "command": "reqord issue create <spec-id>",
        "description": "GitHub Issue生成"
      },
      {
        "command": "reqord status",
        "description": "プロジェクト全体ステータス"
      },
      {
        "command": "reqord preview",
        "description": "Web UIプレビュー (localhost:3000)"
      }
    ]
  },
  "deployment": {
    "cli": {
      "platform": "npm registry",
      "command": "npm publish",
      "description": "CLIツールとしてnpmに公開"
    },
    "web": {
      "platform": "Vercel",
      "description": "Next.jsアプリとしてVercelにデプロイ"
    }
  },
  "designPrinciples": [
    {
      "name": "構造化第一",
      "description": "JSON(メタデータ) + Markdown(コンテンツ)のハイブリッド。機械処理可能な構造と人間可読なコンテンツを分離"
    },
    {
      "name": "ローカル完結",
      "description": "GitHubリポジトリがSSoT。バックエンドサーバー不要。.reqord/ディレクトリにすべて格納"
    },
    {
      "name": "AI駆動最適化",
      "description": "Claude Code等のLLMツールとの統合を前提設計。コンテキスト提供の最適化、トークン効率"
    },
    {
      "name": "視覚化重視",
      "description": "依存関係グラフ、Ganttチャート、進捗ダッシュボードによる直感的な状態把握"
    }
  ]
}
