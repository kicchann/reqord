{
  "name": "reqord",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm --filter @reqord/shared run build && pnpm --filter @reqord/cli run build && pnpm --filter @reqord/web run build",
    "clean": "rm -rf packages/*/dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p packages/shared/tsconfig.check.json && tsc --noEmit -p packages/cli/tsconfig.check.json && tsc --noEmit -p packages/web/tsconfig.json",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.0.0"
  }
}
