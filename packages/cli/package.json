  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@reqord/shared": "workspace:*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.1"
  },
  "peerDependencies": {
    "@reqord/web": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@reqord/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.7.0"
  }
}
